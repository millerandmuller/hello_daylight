# Local development. Copy to .env (gitignored). Nothing in this file is a real key.

# The operator's Gemini key, used for signed-in (private) runs. Public runs always use the visitor's own key.
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Sign-in. Locally "dev" lets you type any email; it is refused on Cloud Run. In the cloud use "firebase".
DAYLIGHT_AUTH_MODE=dev
DAYLIGHT_ADMIN_EMAILS=you@example.com
# Required on Cloud Run (32+ random characters); any value locally.
# DAYLIGHT_SESSION_SECRET=

# Storage: "file" (default locally, under .data/) or "firestore" (default on Cloud Run).
# DAYLIGHT_BACKEND=file

# Money. The per-run budget can only be lowered from here; raising the ceiling is a deliberate act.
# DAYLIGHT_RUN_BUDGET_EUR=0.05        lower the budget of every run (a kill-switch drill)
# DAYLIGHT_BUDGET_CEILING_EUR=1.50    private run ceiling
# DAYLIGHT_PUBLIC_BUDGET_CEILING_EUR=1.00
# DAYLIGHT_MONTH_CAP_EUR=25           per workspace and month
# DAYLIGHT_GLOBAL_MONTH_CAP_EUR=60    all workspaces together

# Models (one line each; see config.py for prices)
# DAYLIGHT_MODEL_CHEAP=gemini-3.5-flash-lite
# DAYLIGHT_MODEL_MID=gemini-3.8-flash
# DAYLIGHT_MODEL_STRONG=gemini-3.1-pro-preview

# Optional: a read-only GitHub token (public data only) lifts the search rate limit.
# GITHUB_TOKEN=
# Bluesky's public search is closed without a login (checked 2026-10-04). Switch on where it is open.
# DAYLIGHT_ENABLE_BLUESKY=1

# Firebase web config for the sign-in page (these three values are public by design)
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
